# =====================================================================
#  AAM Ambiental & Mineral — variáveis de ambiente (exemplo)
#  Copie para .env e preencha. NUNCA commitar o .env real.
# =====================================================================

# Banco (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/amm?sslmode=require"

# Autenticação (NextAuth)
AUTH_SECRET="<gere um segredo aleatório>"
AUTH_TRUST_HOST="true"
# URL pública da aplicação (sem prefixo NEXT_PUBLIC — não é exposta ao navegador)
APP_URL="http://localhost:3000"

# Object Storage (Vercel Blob — compatível com o padrão; S3/R2 futuros)
BLOB_READ_WRITE_TOKEN="<token do Vercel Blob>"

# OCR futuro (a definir — não implementado ainda)
# OCR_API_KEY=""
# OCR_PROVIDER="ocr.space"

# E-mail futuro (Resend — não implementado ainda)
# RESEND_API_KEY=""
# RESEND_FROM="AAM <contato@aam.com.br>"

# Cron prazos (Render — worker separado, não implementado ainda)
# CRON_SECRET="<secreto compartilhado entre Vercel e Render>"
